<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.student.mapper.UserCouponMapper">

    <resultMap id="UserCouponResultMap" type="org.example.student.model.UserCoupon">
        <id property="id" column="id"/>
        <result property="couponNo" column="coupon_no"/>
        <result property="userId" column="user_id"/>
        <result property="templateCode" column="template_code"/>
        <result property="couponName" column="coupon_name"/>
        <result property="couponType" column="coupon_type"/>
        <result property="faceValue" column="face_value"/>
        <result property="thresholdAmount" column="threshold_amount"/>
        <result property="status" column="status"/>
        <result property="receiveTime" column="receive_time"/>
        <result property="useTime" column="use_time"/>
        <result property="expireTime" column="expire_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="UserCouponColumns">
        id, coupon_no, user_id, template_code, coupon_name, coupon_type,
        face_value, threshold_amount, status, receive_time, use_time,
        expire_time, create_time, update_time
    </sql>

    <insert id="insertUserCoupon" parameterType="org.example.student.model.UserCoupon"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_coupon (
            coupon_no, user_id, template_code, coupon_name, coupon_type,
            face_value, threshold_amount, status, receive_time, use_time,
            expire_time, create_time, update_time
        ) VALUES (
            #{couponNo}, #{userId}, #{templateCode}, #{couponName}, #{couponType},
            #{faceValue}, #{thresholdAmount}, #{status}, NOW(), #{useTime},
            #{expireTime}, NOW(), NOW()
        )
    </insert>

    <select id="findUserCouponById" resultMap="UserCouponResultMap">
        SELECT <include refid="UserCouponColumns"/>
        FROM user_coupon
        WHERE id = #{id}
    </select>

    <select id="findUserCouponByCouponNo" resultMap="UserCouponResultMap">
        SELECT <include refid="UserCouponColumns"/>
        FROM user_coupon
        WHERE coupon_no = #{couponNo}
    </select>

</mapper>
