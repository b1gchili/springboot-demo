<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.student.mapper.UserMapper">

    <select id="listUsers" resultType="org.example.student.model.UserListItem">
        SELECT user_id, username, display_name, phone, last_login_time
        FROM sys_user
        WHERE enabled = 1
        ORDER BY last_login_time DESC, id ASC
    </select>

</mapper>
