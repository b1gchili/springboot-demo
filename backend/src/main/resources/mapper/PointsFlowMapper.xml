<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.student.mapper.PointsFlowMapper">

    <resultMap id="PointsFlowResultMap" type="org.example.student.model.PointsFlow">
        <id property="id" column="id"/>
        <result property="flowNo" column="flow_no"/>
        <result property="userId" column="user_id"/>
        <result property="changePoints" column="change_points"/>
        <result property="beforePoints" column="before_points"/>
        <result property="afterPoints" column="after_points"/>
        <result property="flowType" column="flow_type"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceBizId" column="source_biz_id"/>
        <result property="reason" column="reason"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="PointsFlowVOResultMap" type="org.example.student.model.PointsFlowVO">
        <result property="flowNo" column="flow_no"/>
        <result property="userId" column="user_id"/>
        <result property="changePoints" column="change_points"/>
        <result property="beforePoints" column="before_points"/>
        <result property="afterPoints" column="after_points"/>
        <result property="flowType" column="flow_type"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceBizId" column="source_biz_id"/>
        <result property="reason" column="reason"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="PointsFlowColumns">
        id, flow_no, user_id, change_points, before_points, after_points,
        flow_type, source_type, source_biz_id, reason, create_time
    </sql>

    <insert id="insertPointsFlow" parameterType="org.example.student.model.PointsFlow"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO points_flow (
            flow_no, user_id, change_points, before_points, after_points,
            flow_type, source_type, source_biz_id, reason, create_time
        ) VALUES (
            #{flowNo}, #{userId}, #{changePoints}, #{beforePoints}, #{afterPoints},
            #{flowType}, #{sourceType}, #{sourceBizId}, #{reason}, NOW()
        )
    </insert>

    <select id="listByUserId" resultMap="PointsFlowVOResultMap">
        SELECT <include refid="PointsFlowColumns"/>
        FROM points_flow
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
    </select>

</mapper>
