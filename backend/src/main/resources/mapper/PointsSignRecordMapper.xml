<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.student.mapper.PointsSignRecordMapper">

    <resultMap id="PointsSignRecordResultMap" type="org.example.student.model.PointsSignRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="signDate" column="sign_date"/>
        <result property="rewardPoints" column="reward_points"/>
        <result property="continuousDays" column="continuous_days"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="PointsSignRecordColumns">
        id, user_id, sign_date, reward_points, continuous_days, create_time
    </sql>

    <insert id="insertSignRecord" parameterType="org.example.student.model.PointsSignRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO points_sign_record (
            user_id, sign_date, reward_points, continuous_days, create_time
        ) VALUES (
            #{userId}, #{signDate}, #{rewardPoints}, #{continuousDays}, NOW()
        )
    </insert>

    <select id="findByUserIdAndSignDate" resultMap="PointsSignRecordResultMap">
        SELECT <include refid="PointsSignRecordColumns"/>
        FROM points_sign_record
        WHERE user_id = #{userId}
          AND sign_date = #{signDate}
    </select>

</mapper>
